{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "sensors": ["./sensors.ts"],
      "display": ["./display.ts"],
      "floor": ["./floor.ts"],
      "prod": ["./prod.json"],
      "lib/noise": ["./lib/noise.d.ts"]
    }
  },
  "include": ["*.ts", "behs/**/*.js", "lib/**/*.js", "types/**/*.d.ts"]
}
